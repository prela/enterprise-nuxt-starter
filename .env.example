# Copy to `.env` for local `pnpm dev` and Compose. Do not commit `.env`.

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (ADR-0003). Identity later attaches Drizzle to this engine. Not MySQL.
POSTGRES_USER=playground
POSTGRES_PASSWORD=playground
POSTGRES_DB=playground

# Host-side URLs (`pnpm dev` against Compose Postgres published on localhost).
# NUXT_DATABASE_URL is Core runtimeConfig. DATABASE_URL is the same URL for Drizzle Kit / Identity later.
# The Playground Compose service rebuilds these from POSTGRES_* and the `postgres` hostname.
NUXT_DATABASE_URL=postgresql://playground:playground@localhost:5432/playground
DATABASE_URL=postgresql://playground:playground@localhost:5432/playground
